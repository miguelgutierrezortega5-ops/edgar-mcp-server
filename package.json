{
  "name": "edgar-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for free public financial data: SEC EDGAR (financials, filings, insider trades, 13F portfolios, full-text search), stock prices and dividends, US Treasury yields, FRED and World Bank macro data",
  "license": "MIT",
  "author": "miguelgutierrezortega5-ops (https://github.com/miguelgutierrezortega5-ops)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelgutierrezortega5-ops/edgar-mcp-server.git"
  },
  "homepage": "https://github.com/miguelgutierrezortega5-ops/edgar-mcp-server#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "sec",
    "edgar",
    "xbrl",
    "finance",
    "stocks",
    "13f",
    "fred",
    "macro"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "edgar-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist build",
    "setup": "node scripts/setup.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:live": "npm run build && node test/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "skills",
    "scripts/setup.mjs",
    "manifest.json",
    "README.md",
    "LICENSE"
  ]
}
