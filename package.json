{
  "name": "edgar-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for free public financial data: SEC EDGAR (filings, XBRL financials, insider trades, full-text search), US Treasury yields and stock prices",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "edgar-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:live": "npm run build && node test/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ]
}
