{
  "name": "trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto and forex trading bot: market monitoring, EMA/RSI/ATR strategy, risk management, paper trading, backtesting and optional live execution (ccxt exchanges, OANDA)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "bot": "node dist/index.js run",
    "scan": "node dist/index.js scan",
    "backtest": "node dist/index.js backtest",
    "status": "node dist/index.js status",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "ccxt": "^4.5.84",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
