# Copia este archivo a .env y rellena solo lo que vayas a usar.
# En modo paper (el de por defecto) no hace falta ninguna clave.

# --- Exchange de criptomonedas (crypto.broker = "exchange") ---
# Crea una clave de API SOLO con permiso de trading (nunca de retirada de fondos).
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
# Solo algunos exchanges (OKX, KuCoin, Bitget…) piden además una contraseña de API.
CRYPTO_API_PASSWORD=

# --- OANDA (forex.broker = "oanda" o forex.data = "oanda") ---
# Token en OANDA → Manage API Access. Cuenta demo: oandaEnv "practice".
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# --- Avisos por Telegram (opcional) ---
# Crea un bot con @BotFather y consigue tu chat id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dinero real ---
# El bot se niega a operar con dinero real (exchange con sandbox: false u OANDA "live")
# salvo que descomentes esta línea.
# CONFIRMAR_DINERO_REAL=si
